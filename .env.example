# Copy to .env - never commit the real one (see .gitignore).
NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string with a <PASSWORD> placeholder (config/db.js
# substitutes DATABASE_PASSWORD into it).
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_PASSWORD=change-me

# Where uploaded intake documents and book covers are written (default: ./uploads)
# UPLOAD_DIR=/var/data/shekel-uploads

# AWS S3 - the files bucket (since 2026-10-26; project-files/specs/files-s3-plan.html, section 8).
# The IAM user shekel-app may only Put/Get/Delete/Tag objects of this one bucket. Keys never go in git.
AWS_REGION=il-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=shekel-files-prod
